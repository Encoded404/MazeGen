{
    "name": "vulkan-engine-v5",
    "description": "Vulkan Engine V5",
    "version": "1.0.0",
    "license": "MIT",
    "dependencies": [
        {
            "name": "gtest",
            "version>=": "1.13.0"
        },
        "vulkan-headers",
        {
            "name": "vulkan-loader",
            "platform": "windows"
        },
        {
            "name": "ktx",
            "features": [ "vulkan" ]
        },
        {
            "name": "sdl3",
            "default-features": false,
            "features": [
                "vulkan",
                {
                    "name": "wayland",
                    "platform": "linux"
                },
                {
                    "name": "x11",
                    "platform": "linux"
                }
            ]
        },
        "nlohmann-json",
        "glm",
        "stb",
        "tinyobjloader",
        "cli11",
        {
            "name": "imgui",
            "features": [ "vulkan-binding", "sdl3-binding" ]
        },
        "efsw",
        {
            "name": "shader-slang",
            "platform": "!windows"
        },
        "harfbuzz",
        {
            "name": "freetype",
            "default-features": false
        },
        {
            "name": "msdfgen",
            "default-features": false
        },
        "libunibreak",
        {
            "name": "joltphysics",
            "features": [ "debugrenderer", "rtti" ]
        }
    ]
}